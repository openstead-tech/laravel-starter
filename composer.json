{
  "name": "openstead/laravel-verification",
  "description": "Isolated Laravel, MySQL and persistent upload verification fixture",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-pdo_mysql": "*",
    "laravel/framework": "^12.0"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {"optimize-autoloader": true, "sort-packages": true, "platform": {"php": "8.4.0"}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
